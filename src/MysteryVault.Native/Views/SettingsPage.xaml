<Page x:Class="MysteryVault.Native.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="32" Spacing="22">
    <TextBlock Text="Settings" FontSize="32" FontWeight="Bold"/>
    <StackPanel Spacing="8"><TextBlock Text="External player servers" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Import/manage validated HTTPS provider configs (CSV or .env)." Opacity="0.7"/><Button Content="Import server configuration" IsEnabled="False"/></StackPanel>
    <StackPanel Spacing="8"><TextBlock Text="App-only DNS" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="AdGuard DNS and custom DNS-over-HTTPS. Windows DNS will not be changed." Opacity="0.7"/><TextBox Header="DNS-over-HTTPS endpoint" Text="https://dns.adguard-dns.com/dns-query"/><Button Content="Apply DNS" IsEnabled="False"/></StackPanel>
    <StackPanel Spacing="8"><TextBlock Text="Torrent cache" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Choose a dedicated cache folder and clear it after active sessions stop." Opacity="0.7"/><Button Content="Choose storage folder" IsEnabled="False"/><Button Content="Clear torrent cache" IsEnabled="False"/></StackPanel>
    <StackPanel Spacing="8"><TextBlock Text="Player" FontSize="20" FontWeight="SemiBold"/><CheckBox Content="Enable player sandbox" IsChecked="True" IsEnabled="False"/></StackPanel>
    <TextBlock Text="Controls are placeholders until their C# services are implemented." Opacity="0.65" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
</Page>
