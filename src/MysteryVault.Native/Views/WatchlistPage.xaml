<Page x:Class="MysteryVault.Native.Views.WatchlistPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="32"><StackPanel Spacing="12">
    <TextBlock Text="Watchlist" FontSize="32" FontWeight="Bold"/>
    <TextBlock x:Name="WatchlistStatus" Text="Your saved titles are stored locally on this PC." Opacity="0.7"/>
    <ListView x:Name="WatchlistItems" DisplayMemberPath="Title" SelectionMode="Single"/>
    <Button x:Name="RemoveButton" Content="Remove selected title" HorizontalAlignment="Left" Click="RemoveButton_Click"/>
  </StackPanel></Grid>
</Page>
