<Window
    x:Class="MysteryVault.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Mystery Vault">
    <muxc:NavigationView x:Name="AppNavigation"
                         PaneDisplayMode="Left"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False"
                         SelectionChanged="AppNavigation_SelectionChanged">
        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem Content="Library" Tag="Home"/>
            <muxc:NavigationViewItem Content="Watchlist" Tag="Watchlist"/>
            <muxc:NavigationViewItem Content="Settings" Tag="Settings"/>
        </muxc:NavigationView.MenuItems>
        <muxc:NavigationView.FooterMenuItems>
            <muxc:NavigationViewItem Content="Toggle theme" Tag="Theme"/>
        </muxc:NavigationView.FooterMenuItems>
        <muxc:Frame x:Name="ContentFrame"/>
    </muxc:NavigationView>
</Window>
