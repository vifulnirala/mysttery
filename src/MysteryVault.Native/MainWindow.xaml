<Window
    x:Class="MysteryVault.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mystery Vault">
    <NavigationView x:Name="AppNavigation"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    SelectionChanged="AppNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Library" Tag="Home"/>
            <NavigationViewItem Content="Watchlist" Tag="Watchlist"/>
            <NavigationViewItem Content="Settings" Tag="Settings"/>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Toggle theme" Tag="Theme"/>
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame"/>
    </NavigationView>
</Window>
