<Window x:Class="MysteryVault.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mystery Vault">
  <Grid Background="{ThemeResource AppBackgroundBrush}">
    <NavigationView x:Name="AppNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="AppNavigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Library" Tag="Home"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Watchlist" Tag="Watchlist"><NavigationViewItem.Icon><SymbolIcon Symbol="Favorite"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Settings" Tag="Settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="Toggle theme" Tag="Theme"><NavigationViewItem.Icon><SymbolIcon Symbol="Brightness"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Frame x:Name="ContentFrame"/>
    </NavigationView>
  </Grid>
</Window>
