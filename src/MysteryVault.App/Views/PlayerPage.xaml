<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MysteryVault.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,0,0,12">
            <Button Content="Back" Click="Back_Click" />
            <ToggleButton x:Name="SandboxToggle"
                          Content="Embed Sandbox"
                          IsChecked="True"
                          Click="SandboxToggle_Click" />
            <TextBlock x:Name="PlayerStatusText" VerticalAlignment="Center" Opacity="0.8" />
        </StackPanel>

        <Grid Grid.Row="1">
            <MediaPlayerElement x:Name="VideoPlayer"
                                AreTransportControlsEnabled="True"
                                Visibility="Collapsed" />
            <WebView2 x:Name="EmbedWebView"
                      Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
