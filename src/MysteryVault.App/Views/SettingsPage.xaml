<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MysteryVault.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cfg="using:MysteryVault.Core.Configuration"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Spacing="24" MaxWidth="720" HorizontalAlignment="Left" Padding="0,0,0,32">
            <TextBlock Text="Settings" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <StackPanel Spacing="8">
                <TextBlock Text="DNS-over-HTTPS" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox Header="DoH Endpoint" Text="{x:Bind ViewModel.DohEndpoint, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save DoH" Click="SaveDoh_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Use AdGuard DNS" Click="UseAdGuard_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Torrent Cache" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.CacheDirectory, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" />
                <Button Content="Clear Cache" Click="ClearCache_Click" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Embed Server Manager" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox Header="Import Servers (CSV or id=url lines)"
                         AcceptsReturn="True"
                         Height="96"
                         Text="{x:Bind ViewModel.ImportText, Mode=TwoWay}" />
                <Button Content="Import Servers" Click="ImportServers_Click" />
                <ListView ItemsSource="{x:Bind ViewModel.EmbedProviders}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="cfg:EmbedServerDefinition">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="4">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Width="140" />
                                <TextBlock Text="{x:Bind MovieUrlTemplate}" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
