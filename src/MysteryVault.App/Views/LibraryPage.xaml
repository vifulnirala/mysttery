<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MysteryVault.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MysteryVault.Core.Models"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Spacing="16" Padding="0,0,0,32">
            <TextBlock Text="Library — Curated Catalog" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <GridView ItemsSource="{x:Bind Items}"
                      IsItemClickEnabled="True"
                      SelectionMode="None"
                      ItemClick="CatalogItem_Click">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaItem">
                        <Border Width="172"
                                Height="296"
                                Margin="0,0,10,8"
                                CornerRadius="16"
                                Background="{StaticResource MvSurfaceBrush}"
                                BorderBrush="{StaticResource MvBorderBrush}"
                                BorderThickness="1">
                            <Grid RowDefinitions="216,*">
                                <Border Grid.Row="0" CornerRadius="15,15,0,0" Background="{StaticResource MvSurface2Brush}">
                                    <Image Source="{x:Bind PosterUrl}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Row="1" Padding="10,8" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock Text="{x:Bind ReleaseYear}" Foreground="{StaticResource MvMutedBrush}" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
