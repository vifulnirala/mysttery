<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MysteryVault.App.Views.WatchlistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MysteryVault.Core.Models"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Spacing="16" Padding="0,0,0,32">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="Watchlist" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <Button Content="Clear All" Click="ClearAll_Click" VerticalAlignment="Center" />
            </StackPanel>
            <GridView ItemsSource="{x:Bind ViewModel.Items}"
                      IsItemClickEnabled="True"
                      SelectionMode="None"
                      ItemClick="WatchlistItem_Click">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:WatchlistEntry">
                        <Border Width="172"
                                Height="296"
                                Margin="0,0,8,8"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid RowDefinitions="216,*">
                                <Border Grid.Row="0" CornerRadius="7,7,0,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image Source="{x:Bind PosterUrl}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Row="1" Padding="10,8" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock Text="{x:Bind ReleaseYear}" Opacity="0.65" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
