<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MysteryVault.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MysteryVault.Core.Models"
    Loaded="Page_Loaded">
    <Page.Resources>
        <DataTemplate x:Key="PosterCardTemplate" x:DataType="models:MediaItem">
            <Border Width="168"
                    Height="296"
                    Margin="0,0,10,8"
                    CornerRadius="16"
                    Background="{StaticResource MvSurfaceBrush}"
                    BorderBrush="{StaticResource MvBorderBrush}"
                    BorderThickness="1">
                <Grid RowDefinitions="220,*">
                    <Border Grid.Row="0" CornerRadius="15,15,0,0" Background="{StaticResource MvSurface2Brush}">
                        <Image Source="{x:Bind PosterUrl}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Row="1" Padding="10,8" Spacing="2">
                        <TextBlock Text="{x:Bind Title}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                        <TextBlock Text="{x:Bind ReleaseYear}"
                                   Foreground="{StaticResource MvMutedBrush}"
                                   FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Spacing="28" Padding="0,0,0,40">
            <!-- Centered Hero matching original Mystery Vault -->
            <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="780" Margin="0,12,0,8">
                <Border HorizontalAlignment="Center"
                        CornerRadius="999"
                        Padding="12,5"
                        Background="{StaticResource MvSurfaceBrush}"
                        BorderBrush="{StaticResource MvBorderBrush}"
                        BorderThickness="1">
                    <TextBlock Text="MYSTERY VAULT · NATIVE EDITION"
                               Foreground="{StaticResource MvAccent2Brush}"
                               FontSize="11"
                               FontWeight="Bold"
                               CharacterSpacing="80" />
                </Border>
                <TextBlock Text="Uncover Every Mystery."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="46"
                           FontWeight="Bold" />
                <TextBlock Text="Stream TMDB titles directly in the embed player or search verified torrent clues."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{StaticResource MvMutedBrush}"
                           FontSize="15" />

                <Border Padding="8"
                        CornerRadius="18"
                        Background="{StaticResource MvSurfaceBrush}"
                        BorderBrush="{StaticResource MvBorderBrush}"
                        BorderThickness="1">
                    <AutoSuggestBox x:Name="HeroSearchBox"
                                    PlaceholderText="Search movies, shows, or Scooby-Doo..."
                                    QueryIcon="Find"
                                    Width="560"
                                    QuerySubmitted="HeroSearchBox_QuerySubmitted" />
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Content="Scooby-Doo" CornerRadius="12" Click="QuickChip_Click" />
                    <Button Content="Avatar" CornerRadius="12" Click="QuickChip_Click" />
                    <Button Content="Interstellar" CornerRadius="12" Click="QuickChip_Click" />
                    <Button Content="Inception" CornerRadius="12" Click="QuickChip_Click" />
                </StackPanel>

                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" />
                <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Midnight Shelf (Legal Catalog)" Style="{StaticResource SubtitleTextBlockStyle}" />
                <GridView ItemsSource="{x:Bind ViewModel.MidnightShelf}"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          ItemClick="MediaItem_Click">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <Border Width="236"
                                    Height="118"
                                    Margin="0,0,10,8"
                                    Padding="12"
                                    CornerRadius="16"
                                    Background="{StaticResource MvSurfaceBrush}"
                                    BorderBrush="{StaticResource MvBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"
                                               MaxLines="2" />
                                    <TextBlock Text="{x:Bind ReleaseYear}" Foreground="{StaticResource MvMutedBrush}" FontSize="12" />
                                    <TextBlock Text="{x:Bind Overview}"
                                               Foreground="{StaticResource MvMutedBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Trending This Week" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.Trending}"
                          ItemTemplate="{StaticResource PosterCardTemplate}"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          ItemClick="MediaItem_Click"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Mystery" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.MysteryGenre}"
                          ItemTemplate="{StaticResource PosterCardTemplate}"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          ItemClick="MediaItem_Click"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Animation" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.AnimationGenre}"
                          ItemTemplate="{StaticResource PosterCardTemplate}"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          ItemClick="MediaItem_Click"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Horror" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.HorrorGenre}"
                          ItemTemplate="{StaticResource PosterCardTemplate}"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          ItemClick="MediaItem_Click"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Comedy" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.ComedyGenre}"
                          ItemTemplate="{StaticResource PosterCardTemplate}"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          ItemClick="MediaItem_Click"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Romance" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.RomanceGenre}"
                          ItemTemplate="{StaticResource PosterCardTemplate}"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          ItemClick="MediaItem_Click"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
