<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MysteryVault.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MysteryVault.Core.Models"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,0,32">
            <StackPanel Spacing="12">
                <TextBlock Text="Mystery Vault" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <AutoSuggestBox x:Name="HeroSearchBox"
                                PlaceholderText="Search movies, shows, or Scooby-Doo..."
                                QueryIcon="Find"
                                MaxWidth="560"
                                HorizontalAlignment="Left"
                                QuerySubmitted="HeroSearchBox_QuerySubmitted" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Scooby-Doo" Click="QuickChip_Click" />
                    <Button Content="Avatar" Click="QuickChip_Click" />
                    <Button Content="Interstellar" Click="QuickChip_Click" />
                    <Button Content="Inception" Click="QuickChip_Click" />
                </StackPanel>
                <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Midnight Shelf (Legal Catalog)" Style="{StaticResource SubtitleTextBlockStyle}" />
                <GridView ItemsSource="{x:Bind ViewModel.MidnightShelf}" SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <StackPanel Width="220" Padding="12" Spacing="4">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Text="{x:Bind ReleaseYear}" Opacity="0.7" FontSize="12" />
                                <TextBlock Text="{x:Bind Overview}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="2" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Trending This Week" Style="{StaticResource SubtitleTextBlockStyle}" />
                <GridView ItemsSource="{x:Bind ViewModel.Trending}" SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <StackPanel Width="200" Padding="8" Spacing="4">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Text="{x:Bind ReleaseYear}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
