<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MysteryVault.App.Views.SearchResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MysteryVault.Core.Models">
    <ScrollViewer>
        <StackPanel Spacing="20" Padding="0,0,0,32">
            <TextBlock Text="Search" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <AutoSuggestBox x:Name="SearchBox"
                                Width="380"
                                PlaceholderText="Search titles or torrents..."
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.Query, Mode=TwoWay}"
                                QuerySubmitted="SearchBox_QuerySubmitted" />
                <ComboBox Header="Quality"
                          ItemsSource="{x:Bind ViewModel.QualityOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" />
                <Button Content="Search" Style="{StaticResource AccentButtonStyle}" Click="SearchButton_Click" />
            </StackPanel>

            <TextBlock Text="Titles" Style="{StaticResource SubtitleTextBlockStyle}" />
            <GridView ItemsSource="{x:Bind ViewModel.TitleResults}" SelectionMode="None">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaItem">
                        <StackPanel Width="220" Padding="10" Spacing="4">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                            <TextBlock Text="{x:Bind Source}" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock Text="Torrents" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.TorrentResults}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TorrentResult">
                        <StackPanel Orientation="Horizontal" Spacing="16" Padding="8">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Width="360" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Quality}" Width="72" />
                            <TextBlock Text="{x:Bind SizeDisplay}" Width="90" />
                            <TextBlock Text="{x:Bind Seeds}" Width="60" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
