<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MysteryVault.App.Views.SearchResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MysteryVault.Core.Models">
    <ScrollViewer>
        <StackPanel Spacing="20" Padding="0,0,0,36">
            <TextBlock Text="Search" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <AutoSuggestBox x:Name="SearchBox"
                                Width="380"
                                PlaceholderText="Search titles or torrents..."
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.Query, Mode=TwoWay}"
                                QuerySubmitted="SearchBox_QuerySubmitted" />
                <ComboBox Header="Quality"
                          ItemsSource="{x:Bind ViewModel.QualityOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" />
                <Button Content="Search" Style="{StaticResource AccentButtonStyle}" Click="SearchButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>

            <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" HorizontalAlignment="Left" />
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <TextBlock Text="Titles (Click to search streams or save)" Style="{StaticResource SubtitleTextBlockStyle}" />
            <GridView ItemsSource="{x:Bind ViewModel.TitleResults}"
                      IsItemClickEnabled="True"
                      SelectionMode="None"
                      ItemClick="TitleItem_Click">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaItem">
                        <Border Width="172"
                                Height="296"
                                Margin="0,0,8,8"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid RowDefinitions="216,*">
                                <Border Grid.Row="0" CornerRadius="7,7,0,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image Source="{x:Bind PosterUrl}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Row="1" Padding="10,8" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock Text="{x:Bind Source}" Opacity="0.65" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock Text="Torrents (Click row to stream)" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.TorrentResults}"
                      IsItemClickEnabled="True"
                      SelectionMode="None"
                      ItemClick="TorrentItem_Click">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TorrentResult">
                        <Grid ColumnDefinitions="*,84,96,72" Padding="8,10" ColumnSpacing="12">
                            <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Quality}" Opacity="0.85" />
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeDisplay}" Opacity="0.85" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Seeds}" Opacity="0.85" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
