<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MysteryVault.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mystery Vault">
    <Grid Background="{StaticResource MvBgBrush}">
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        Background="Transparent"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" Icon="Home" />
                <NavigationViewItem Content="Library" Tag="library" Icon="Library" />
                <NavigationViewItem Content="Search" Tag="search" Icon="Find" />
                <NavigationViewItem Content="Watchlist" Tag="watchlist" Icon="Bookmarks" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="ThemeToggleItem" Content="Toggle Theme" Margin="0,0,16,0" Tapped="ThemeToggleItem_Tapped" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE706;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Padding="28,16,28,28" />
        </NavigationView>
    </Grid>
</Window>
